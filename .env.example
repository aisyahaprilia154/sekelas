# Untuk lokal, DATABASE_MODE=local menggunakan SQLite.
# Untuk Supabase, jalankan supabase/schema.sql dan isi konfigurasi di bawah.
DATABASE_MODE=local
SUPABASE_URL=
# Secret key / service_role key untuk server, disimpan hanya di .env.
SUPABASE_KEY=
PORT=3000
# Opsional untuk mode local
# SQLITE_PATH=data/sekelas.sqlite
